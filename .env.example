LLM_PROVIDER=echo
LLM_MODEL=
LLM_API_KEY=

# /ws shared-secret gate. EMPTY = auth disabled (local dev).
# When set, configure the same token in the extension popup ("auth token").
WS_AUTH_TOKEN=

# Per-connection flood guard
RATE_LIMIT_MSGS=60
RATE_LIMIT_WINDOW_S=10

# Set false to force text-only planning even for vision-capable models
LLM_VISION=true

# --- Cloud open-weight endpoints (SIH demo path) ---
# LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-120b        (Groq dropped hosted VLMs; text-only, image fallback automatic)
# LLM_API_KEY=gsk_...

# LLM_PROVIDER=openrouter
# LLM_MODEL=openrouter/free            (router auto-picks a vision-capable free model)
# LLM_API_KEY=sk-or-...

# --- Self-hosted vLLM (production path) ---
# LLM_PROVIDER=vllm
# LLM_BASE_URL=http://localhost:8000/v1
